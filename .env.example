# Database
# Local development can keep using SQLite. Production should set DATABASE_URL
# to a managed PostgreSQL database so bookings survive deploys and restarts.
PORT=3000
DB_CLIENT=
DATABASE_URL=
DATABASE_SSL=true
DATA_DIR=./server

# DHL API Credentials
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=
DHL_ENVIRONMENT=production

# Origin Address
DHL_ORIGIN_COUNTRY_CODE=JM
DHL_ORIGIN_POSTAL_CODE=
DHL_ORIGIN_CITY_NAME=Kingston

# Resend API
RESEND_API_KEY=

# WiPay Credentials
WIPAY_ACCOUNT_NUMBER=
WIPAY_API_KEY=
WIPAY_ENVIRONMENT=live
