# Environment
NODE_ENV=production
PORT=3000
SITE_URL=

# Admin Security
SESSION_SECRET=
ADMIN_EMAILS=

# Database
# Local development can keep using SQLite. Production should set DATABASE_URL
# to a managed PostgreSQL database so bookings survive deploys and restarts.
DB_CLIENT=
DATABASE_URL=
DATABASE_SSL=true
DATA_DIR=./server

# Firebase Realtime Database backup / restore
# The public web config is not enough for server writes when rules are locked.
# Use a Firebase service account on the server.
FIREBASE_SYNC_ENABLED=true
FIREBASE_DATABASE_URL=
FIREBASE_SYNC_PATH=windross-tailoring-backup
FIREBASE_PROJECT_ID=windross-tailoring
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# DHL API Credentials
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=
DHL_ENVIRONMENT=production

# Origin Address
DHL_ORIGIN_COUNTRY_CODE=JM
DHL_ORIGIN_POSTAL_CODE=
DHL_ORIGIN_CITY_NAME=Kingston

# Resend API
RESEND_API_KEY=

# WiPay Credentials
WIPAY_ACCOUNT_NUMBER=
WIPAY_API_KEY=
WIPAY_ENVIRONMENT=production

# Marketing & Tracking
META_PIXEL_ID=
TIKTOK_PIXEL_ID=

# Currency Settings
USD_TO_JMD_RATE=
